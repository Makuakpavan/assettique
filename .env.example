# Copy these into your own env files — never commit real values.

# --- .env (read by Prisma CLI AND Next.js) ---
# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# DATABASE_URL=postgresql://postgres.poexlvkyoxmhoisbycnl:NEW-PASSWORD@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1

# --- .env.local (read by Next.js only) ---
# Supabase Dashboard → Project Settings → Data API (URL) and API Keys (publishable / anon key)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_... or your legacy anon key"
# NEXT_PUBLIC_SUPABASE_URL=https://poexlvkyoxmhoisbycnl.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_yOz3xe62Y4bsT5yGVqlgTg_xwpSFYbT

OPENAI_API_KEY="sk-your-key-here"
NEXT_PUBLIC_APP_URL="https://assettique.vercel.app"

# Optional: AI Match model (default gpt-5.6-sol). Set OPENAI_REASONING_EFFORT="" for non-reasoning models.
# OPENAI_MODEL="gpt-5.6-sol"
# OPENAI_REASONING_EFFORT="low"


