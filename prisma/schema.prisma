// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User/Seller model (id = Supabase auth user ID)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  verified  Boolean  @default(false)
  rating    Float    @default(5.0)
  listings  Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Listings (Properties and Vehicles)
model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   // 'vehicle' | 'property'
  price       BigInt   // Store in smallest unit (kobo/cents)
  currency    String   @default("NGN")
  location    String
  
  // Asset-specific fields
  assetType   String   // 'vehicle' | 'property'
  category    String?  // 'luxury_suv', 'waterfront', etc.
  specs       Json?    // vehicle: make, model, year, mileage, condition, vin | property: landSize, propertyType, titleType
  
  // Media
  images      String[] // JSON array of image URLs
  documents   String[] // JSON array of document URLs
  
  // Status
  status      String   @default("draft") // draft | published | sold
  published   Boolean  @default(false)
  publishedAt DateTime?
  
  // Seller relationship
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  // Metadata
  views       Int      @default(0)
  favorites   Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([sellerId])
  @@index([status])
  @@index([type])
}

// AI Chat sessions
model ChatSession {
  id        String   @id @default(cuid())
  userId    String?  // owner (User.id = Supabase user ID)
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Chat messages for AI matching
model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       String   // 'user' | 'ai'
  content    String
  metadata   String?  // JSON for storing recommendations, etc.
  createdAt  DateTime @default(now())
  
  @@index([sessionId])
}

// Favorites/Wishlist
model Favorite {
  id        String   @id @default(cuid())
  userId    String   // Could extend to have User model
  listingId String
  createdAt DateTime @default(now())
  
  @@unique([userId, listingId])
}
